# Copy to .env (git-ignored) and fill in the values: cp .env.example .env

# Database (MariaDB container)
STREP_DB_NAME=strep
STREP_DB_USER=strep
STREP_DB_PASSWORD=
STREP_DB_ROOT_PASSWORD=

# Mail account used to send account confirmations and notifications
STREP_MAIL_USERNAME=
STREP_MAIL_PASSWORD=

# TLS keystore (PKCS12, alias "tomcat"); see README.md
STREP_KEYSTORE_FILE=./secrets/keystore.p12
STREP_KEYSTORE_PASSWORD=

# Public base URL used in the links of the e-mails
STREP_HOST_NAME=https://localhost:8443

# Published ports
STREP_HTTP_PORT=8080
STREP_HTTPS_PORT=8443
