# syntax=docker/dockerfile:1
#
# STRep web application (Spring Boot)
# Build context: the strep repository root (see compose.yaml)

FROM debian:trixie AS build
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jdk-headless maven \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY pom.xml .
RUN --mount=type=cache,target=/root/.m2 mvn -B -q dependency:go-offline
COPY src src
RUN --mount=type=cache,target=/root/.m2 mvn -B -DskipTests package \
    && cp target/strep-*.jar /build/strep.jar

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-21-jre-headless curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --home-dir /opt/strep --shell /usr/sbin/nologin strep \
    && mkdir -p /opt/strep /var/lib/strep/datasets /var/lib/strep/pipelines /var/lib/strep/csv \
    && chown -R strep:strep /opt/strep /var/lib/strep
WORKDIR /opt/strep
COPY --from=build --chown=strep:strep /build/strep.jar strep.jar
USER strep
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"
EXPOSE 8080 8443
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -fsS -o /dev/null http://localhost:8080/ || exit 1
ENTRYPOINT ["java", "-jar", "/opt/strep/strep.jar"]
